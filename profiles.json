{
  "schemaVersion": 1,
  "groups": [
    {
      "id": "edi850",
      "name": "EDI 850",
      "enabled": true,
      "priority": 10,
      "isDefault": false,
      "filePattern": "\\\\850\\\\.*\\.edi$",
      "rules": [
        {
          "id": "850st02",
          "name": "忽略 ST02 流水號，保留 ST01",
          "enabled": true,
          "useRegularExpression": true,
          "ignoreCase": false,
          "findPattern": "(^|~)(ST\\*[^*~\\r\\n]\u002B\\*)[^*~\\r\\n]*",
          "replacement": "$1$2\u003CIGNORE\u003E"
        }
      ]
    },

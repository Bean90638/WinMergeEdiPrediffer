<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WinMergeEdiPrediffer.Core/WinMergeEdiPrediffer.Core.csproj" />
    <ProjectReference Include="../WinMergeEdiPrediffer.Plugin/WinMergeEdiPrediffer.Plugin.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../../examples/profiles.example.json" Link="profiles.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyPluginPayload" AfterTargets="Build">
    <ItemGroup>
      <PluginPayload Include="../WinMergeEdiPrediffer.Plugin/bin/$(Configuration)/net10.0-windows/WinMergeEdiPrediffer.Plugin.dll;../WinMergeEdiPrediffer.Plugin/bin/$(Configuration)/net10.0-windows/WinMergeEdiPrediffer.Plugin.comhost.dll;../WinMergeEdiPrediffer.Plugin/bin/$(Configuration)/net10.0-windows/WinMergeEdiPrediffer.Plugin.deps.json;../WinMergeEdiPrediffer.Plugin/bin/$(Configuration)/net10.0-windows/WinMergeEdiPrediffer.Plugin.runtimeconfig.json" />
    </ItemGroup>
    <ItemGroup>
      <PluginPayload Include="../WinMergeEdiPrediffer.Plugin/bin/$(Configuration)/net10.0-windows/WinMergeEdiPrediffer.Plugin.bridge.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPayload)" DestinationFolder="$(OutDir)Plugin" SkipUnchangedFiles="true" />
  </Target>
</Project>

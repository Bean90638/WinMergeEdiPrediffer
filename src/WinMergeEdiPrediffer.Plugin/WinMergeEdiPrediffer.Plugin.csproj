<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <EnableComHosting>true</EnableComHosting>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/TypeLibraryBuilder/TypeLibraryBuilder.csproj" ReferenceOutputAssembly="false" />
    <!-- 同一規則原始碼編入 DLL，部署時不需要額外的 Core DLL。 -->
    <Compile Include="../WinMergeEdiPrediffer.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <ComHostTypeLibrary Include="$(IntermediateOutputPath)WinMergeScript.tlb" Id="1" />
  </ItemGroup>
  <Target Name="BuildWinMergeTypeLibrary" BeforeTargets="_CreateComHost" Inputs="../../tools/TypeLibraryBuilder/Program.cs" Outputs="$(IntermediateOutputPath)WinMergeScript.tlb">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../tools/TypeLibraryBuilder/bin/$(Configuration)/net10.0-windows/TypeLibraryBuilder.dll&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)WinMergeScript.tlb&quot;" />
    <Delete Files="$(ComHostIntermediatePath)" />
  </Target>
  <Target Name="RefreshComHostOutputTimestamp" AfterTargets="_CreateComHost" Condition="Exists('$(ComHostIntermediatePath)')">
    <!-- SDK 修改 COM host 資源後仍保留模板時間；相同大小／時間會讓 bin 與 Manager 複製誤判為未變更。 -->
    <Touch Files="$(ComHostIntermediatePath)" />
  </Target>
  <Target Name="BuildWinMergeBridge" AfterTargets="Build"
          Inputs="../../tools/TypeLibraryBuilder/BridgeBuilder.cs;../../tools/TypeLibraryBuilder/native/Bridge.cpp;../../tools/TypeLibraryBuilder/native/Bridge.def;../../tools/TypeLibraryBuilder/native/Kernel32.def;$(IntermediateOutputPath)WinMergeScript.tlb"
          Outputs="$(OutDir)WinMergeEdiPrediffer.Plugin.bridge.dll">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../tools/TypeLibraryBuilder/bin/$(Configuration)/net10.0-windows/TypeLibraryBuilder.dll&quot; --build-bridge &quot;$(MSBuildProjectDirectory)/../../tools/TypeLibraryBuilder/native&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)WinMergeEdiPrediffer.Plugin.bridge.dll&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)WinMergeScript.tlb&quot;" />
    <Copy SourceFiles="$(IntermediateOutputPath)WinMergeEdiPrediffer.Plugin.bridge.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>

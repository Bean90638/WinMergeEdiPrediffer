+{
+	VARIANT path{ VT_BSTR };
+	std::wstring wpath = ucr::toUTF16(originalFilePath);
+	path.bstrVal = SysAllocStringLen(wpath.data(), static_cast<unsigned>(wpath.size()));
+	return SUCCEEDED(::safeInvokeW(piScript, nullptr, L"PluginOriginalFilePath", opPut[1], path));
